# Copy to .env and fill in. .env is gitignored -- never commit real secrets.
#
# Mint the service-principal OAuth secret (used below, and to mint the quickstart token) with:
#   databricks service-principal-secrets-proxy create <sp-numeric-id> --profile <profile> --lifetime 86400s
# The SP also needs USE CATALOG + USE SCHEMA + SELECT + MODIFY on the target table (see README).
#
# Every path loads this file by sourcing it into the shell:  set -a; . ./.env; set +a
# (that sourcing is also what expands ZEROBUS_TABLE from the three components below).

# --- target table (all paths) ---
# Set the three components. ZEROBUS_TABLE (the x-databricks-zerobus-table-name header) AND the
# collector's OAuth authorization_details claim are both built from them, so they can't drift.
CATALOG="<catalog>"
SCHEMA="<schema>"
TABLE_NAME="gpu_otel_metrics"
ZEROBUS_TABLE="${CATALOG}.${SCHEMA}.${TABLE_NAME}"

# --- collector paths (production + dcgm-exporter): the collector holds these ---
# WORKSPACE_URL is the workspace login host, where the OAuth token endpoint (/oidc/v1/token)
# lives -- this is NOT the zerobus host. e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com
WORKSPACE_URL="<workspace-host>.cloud.databricks.com"                          # host only, no https://
WORKSPACE_ID="<numeric-workspace-id>"                                         # used in the token resource scope
ZEROBUS_ENDPOINT="<workspace-id>.zerobus.<region>.cloud.databricks.com:443"   # host:port, no scheme
DATABRICKS_CLIENT_ID="<service-principal-application-id>"
DATABRICKS_CLIENT_SECRET="<oauth secret from the mint command above>"

# --- quickstart path only (direct export; app carries a Bearer token) ---
# A short-lived OAuth *access token* -- NOT the client_secret above. It must itself carry the
# authorization_details claim or ingest fails; see README "Authentication" for the curl.
ZEROBUS_OTLP_ENDPOINT="https://<workspace-id>.zerobus.<region>.cloud.databricks.com:443"   # with https://
DATABRICKS_TOKEN="<oauth access token>"
