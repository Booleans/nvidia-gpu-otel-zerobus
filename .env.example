# Copy to .env and fill in. .env is gitignored -- never commit real secrets.
#
# Mint a service-principal OAuth secret (client_secret) with:
#   databricks service-principal-secrets-proxy create <sp-numeric-id> --profile <profile> --lifetime 86400s
# The SP needs USE_CATALOG + USE_SCHEMA + MODIFY + SELECT on the target table.

# --- shared ---
WORKSPACE_URL="<workspace-id>.zerobus.<region>.cloud.databricks.com"   # host only, no https://
WORKSPACE_ID="<numeric-workspace-id>"
ZEROBUS_ENDPOINT="<workspace-id>.zerobus.<region>.cloud.databricks.com:443"
ZEROBUS_TABLE="<catalog>.<schema>.gpu_otel_metrics"

# --- production path (collector holds these; workload never sees them) ---
DATABRICKS_CLIENT_ID="<service-principal-application-id>"
DATABRICKS_CLIENT_SECRET="<oauth secret from the mint command>"

# --- quickstart path only (direct export; app carries a Bearer token) ---
# A short-lived OAuth *access token* (not the client secret). See README for how to obtain.
ZEROBUS_OTLP_ENDPOINT="https://<workspace-id>.zerobus.<region>.cloud.databricks.com:443"
DATABRICKS_TOKEN="<oauth access token>"
